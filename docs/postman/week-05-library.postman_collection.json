                  "key": "token",
                  "value": "{{invalidToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get(\"userToken\");",
                  "if (!token) throw new Error(\"03 로그인 요청을 먼저 실행하세요.\");",
                  "const position = token.lastIndexOf(\".\") + 1;",
                  "pm.collectionVariables.set(\"invalidToken\", token.slice(0, position) + (token[position] === \"A\" ? \"B\" : \"A\") + token.slice(position + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"INVALID_TOKEN\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_TOKEN\"));"
                ]
              }
            }
          ]
        },
