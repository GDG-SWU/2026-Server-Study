{
  "info": {
    "name": "06 블로그 API 실습",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "articleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 작성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"첫 번째 실습 글\",\n  \"content\": \"블로그 API 실습입니다.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"articleId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 전체 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 단일 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"수정한 제목\",\n  \"content\": \"수정한 내용입니다.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 수정 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 삭제",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 목록 재조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/articles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}